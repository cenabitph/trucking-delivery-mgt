{
  "name": "trucking-delivery-mgt",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "dev:client": "cd client && bun run dev",
    "dev:all": "concurrently \"bun run dev\" \"bun run dev:client\"",
    "build:client": "cd client && bun run build",
    "db:migrate": "psql \"$(grep DATABASE_URL .env | cut -d= -f2-)\" -f schema.sql",
    "db:seed": "DATABASE_URL=$(grep DATABASE_URL .env | cut -d= -f2-) bun run src/seed.ts"
  },
  "dependencies": {
    "hono": "^4.12.16",
    "pdfkit": "^0.18.0",
    "pg": "^8.12.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.11.6",
    "@types/qrcode": "^1.5.6",
    "concurrently": "^8.2.2"
  }
}